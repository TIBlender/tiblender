# TIBlender runtime settings.
# Copy to .env and edit. docker compose auto-loads a .env file in this
# directory for variable substitution; every credential below is blank by
# default so the offline demo (docker compose up --build) needs no secrets.

# Runtime mode / determinism. offline (default) uses fixtures and recorded
# tool responses, a fixed seed, and a fixed clock so `docker compose up
# --build` reproduces the
# same three-cycle demo every run. Set to "live" for real collectors/tools.
TIBLENDER_MODE=offline
TIBLENDER_SEED=20260909
TIBLENDER_CLOCK=auto
TIBLENDER_ENV_FILE=.env
TIBLENDER_FIXTURES_DIR=fixtures
TIBLENDER_CONFIG_DIR=config
TIBLENDER_HISTORY_DIR=output/history

# Input/output (single-cycle `run` command only; `run-cycles`/`cycle` use
# --output-root instead).
TIBLENDER_INPUT_PATH=sample_runs/collector_experiment_sample/sample_run_posts.jsonl
TIBLENDER_OUTPUT_DIR=output

# Host port the `viewer` compose profile publishes the report viewer on
# (`docker compose --profile viewer up viewer`). Change it if 8765 is already
# bound on the machine; the container side stays 8765. This is read by
# docker-compose.yml only, not by the runtime.
TIBLENDER_VIEWER_PORT=8765

# Multi-cycle scheduler
TIBLENDER_CYCLE_INTERVAL_SECONDS=3600
TIBLENDER_COLLECT_WINDOW_HOURS=1.0
TIBLENDER_MAX_DYNAMIC_QUERIES_PER_PLATFORM=30
TIBLENDER_MAX_POSTS_PER_QUERY=100

# LLM-backed runtime. Normal (live) runs require one configured provider.
# Offline/auto runs fall back to deterministic heuristic reports
# automatically when unset.
#
# Profile A: Azure OpenAI / Azure AI Foundry.
# Required keys: provider, endpoint, deployment, API version, API key.
TIBLENDER_LLM_PROVIDER=azure_openai
TIBLENDER_LLM_MODEL=
TIBLENDER_AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
TIBLENDER_AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME
TIBLENDER_AZURE_OPENAI_API_VERSION=2024-12-01-preview
TIBLENDER_AZURE_OPENAI_API_KEY=

# Profile B: OpenAI API or another OpenAI-compatible endpoint.
# Required keys: provider, model, base URL, API key.
# TIBLENDER_LLM_PROVIDER=openai
# TIBLENDER_LLM_MODEL=YOUR-OPENAI-MODEL
TIBLENDER_OPENAI_BASE_URL=https://api.openai.com/v1
TIBLENDER_OPENAI_API_KEY=

# Profile C: Custom OpenAI-compatible report endpoint.
# Required keys: provider, endpoint, deployment/model, API key.
# TIBLENDER_LLM_PROVIDER=openai_compatible
TIBLENDER_REPORT_ENDPOINT=
TIBLENDER_REPORT_DEPLOYMENT=
TIBLENDER_REPORT_API_KEY=

# Optional generic aliases are also accepted by the runtime:
# OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_DEPLOYMENT,
# AZURE_OPENAI_API_VERSION, AZURE_OPENAI_API_KEY.
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
TIBLENDER_LLM_TEMPERATURE=0.0
TIBLENDER_LLM_MAX_OUTPUT_TOKENS=4096
TIBLENDER_LLM_TIMEOUT_SECONDS=60
# Batch agents split their input into chunks so no single reply has to carry a
# whole cycle (a provider truncates an oversized reply at its output cap).
# Posts per post-normalization request / clusters per refinement request.
TIBLENDER_LLM_BATCH_SIZE=20
TIBLENDER_LLM_CLUSTER_BATCH_SIZE=10
# Chunks of one batch agent are sent concurrently, up to this many at a time.
# Result order is by chunk index, so concurrency never changes the output.
TIBLENDER_LLM_MAX_CONCURRENT=8
# Step 3/4 cluster worker pool: clusters are investigated and evaluated
# concurrently, with results collected in cluster order.
TIBLENDER_CLUSTER_WORKERS=4
# Set true only for local smoke tests without an LLM provider.
TIBLENDER_ALLOW_HEURISTIC_REPORTS=false

# Tool execution. Only the configured tool contract is implemented.
TIBLENDER_ENABLE_REAL_TOOLS=true
TIBLENDER_TOOL_TIMEOUT_SECONDS=20
TIBLENDER_MAX_TOOL_RESULTS=5
# Read cap for a tool's JSON response body, in bytes (default 2 MiB). NVD
# returns well over 200 KB for a widely-referenced CVE, and a cap below the
# real payload truncates the body mid-string, so the lookup fails with
# "invalid JSON response" instead of returning the record. WEB_CRAWL has its
# own, much smaller cap below: it fetches HTML pages, not structured records.
TIBLENDER_TOOL_MAX_BYTES=2097152
TIBLENDER_WEB_CRAWL_MAX_BYTES=200000
TIBLENDER_WEB_CRAWL_RENDER_JS=true
TIBLENDER_WEB_CRAWL_WAIT_MS=1000
SEARCH_ENGINE_PROVIDER=searxng
SEARCH_ENGINE_MAX_RESULTS=10
SEARXNG_BASE_URL=http://searxng:8080
# NVD/GitHub keys are optional: NVD_CVE_LOOKUP and GITHUB_SEARCH work
# unauthenticated at a lower rate limit without them.
NVD_API_KEY=
TIBLENDER_NVD_API_KEY=
GITHUB_TOKEN=
GITHUB_API_KEY=
TIBLENDER_GITHUB_TOKEN=
# X (Twitter) bearer token → X collection + X_SEARCH tool.
X_BEARER_TOKEN=
TWITTER_BEARER_TOKEN=
TIBLENDER_X_BEARER_TOKEN=
TIBLENDER_TWITTER_BEARER_TOKEN=
X_BEARER_TOKEN_FILE=
TWITTER_BEARER_TOKEN_FILE=
TIBLENDER_X_BEARER_TOKEN_FILE=
X_BEARER_FALLBACK_TOKEN_FILE=
TIBLENDER_X_BEARER_FALLBACK_TOKEN_FILE=
API_KEYS_FILE=
API_KEYS_PAYPERUSE_FILE=
API_KEYS_FALLBACK_FILE=
# Reddit collection + REDDIT_SEARCH tool: one client id/secret pair unlocks
# both. TIBLENDER_-prefixed and bare names are both accepted (bare wins ties).
TIBLENDER_REDDIT_ACCOUNTS_FILE=
REDDIT_ACCOUNTS_FILE=
TIBLENDER_REDDIT_CLIENT_ID=
REDDIT_CLIENT_ID=
TIBLENDER_REDDIT_CLIENT_SECRET=
REDDIT_CLIENT_SECRET=
TIBLENDER_REDDIT_EXTRA_ACCOUNTS=
REDDIT_EXTRA_ACCOUNTS=
TIBLENDER_REDDIT_USER_AGENT=tiblender/0.1
# Discord collection reads the guilds the credential's account has joined.
# A user-account token is preferred when set (that is what the deployment
# runs on); otherwise the bot token is used. Automating a user account is
# subject to Discord's terms -- see docs/CREDENTIALS.md.
DISCORD_USER_TOKEN=
TIBLENDER_DISCORD_USER_TOKEN=
DISCORD_BOT_TOKEN=
TIBLENDER_DISCORD_BOT_TOKEN=
# Optional per-run bounds (0 = every joined guild / every text channel).
TIBLENDER_DISCORD_MAX_GUILDS=0
TIBLENDER_DISCORD_MAX_CHANNELS_PER_GUILD=0
# VirusTotal API key → PASSIVE_DNS_LOOKUP resolutions (the only passive DNS
# provider). Free tier: 4 requests per minute, 500 per day.
VIRUSTOTAL_API_KEY=
TIBLENDER_VIRUSTOTAL_API_KEY=
TIBLENDER_OCR_ENABLED=true
TIBLENDER_PIVOT_DEPTH=1
# Resolutions considered per IP before that IP counts as a shared-hosting
# environment. A passive-DNS or CT answer for an IP that returns more than this
# many names is describing co-tenancy, not this campaign: the co-resident names
# are dropped instead of being reported as indicators. No confidence bump
# follows -- crowded hosting is a false-positive risk, not corroboration. The
# paper's +1 applies only when the answer links the indicator to a domain the
# posts already named as malicious.
TIBLENDER_PIVOT_MAX_RESOLUTIONS_PER_IP=5
# Passive-DNS resolutions kept per lookup, matching the deployed system's
# 20-item truncation of the VirusTotal payload. The live request asks for
# exactly this many; bundled recordings captured under an older limit=40
# request are truncated to it on replay.
TIBLENDER_PASSIVE_DNS_LIMIT=20
TIBLENDER_PERSPECTIVE_WORKERS=4

# Telegram collector (requires the optional `telethon` dependency, already
# pinned in requirements.txt, plus a user session). Collection covers the
# channels listed in config/telegram_channels.txt, or every channel the
# account has joined when that file lists none (0 = no cap).
TIBLENDER_TELEGRAM_API_ID=
TIBLENDER_TELEGRAM_API_HASH=
TIBLENDER_TELEGRAM_SESSION=
TIBLENDER_TELEGRAM_MAX_CHANNELS=0

# Step 1: adaptive collection and post normalization
TIBLENDER_MIN_TEXT_CHARS=24

# Step 2: dual-track campaign clustering
# Default parameters: tau_J=0.25, tau_abs=0.75, HDBSCAN min_cluster_size=3, min_samples=2, epsilon=0.08.
# Set TIBLENDER_EMBEDDING_BACKEND=bge_large and TIBLENDER_EMBEDDING_FEATURES=1024
# only when the optional reference dependencies and model cache are available.
#
# IMPORTANT: TIBLENDER_MODE=offline pins BOTH embedding backends (clustering
# here and TIBLENDER_TREND_EMBEDDING_BACKEND below) to the deterministic
# hashing vectorizer, because model weights, device, and library version would
# otherwise leak into the output of a run that is supposed to be
# bit-reproducible. In offline mode TIBLENDER_EMBEDDING_BACKEND,
# TIBLENDER_EMBEDDING_MODEL, TIBLENDER_TREND_EMBEDDING_BACKEND and
# TIBLENDER_EMBEDDING_FALLBACK therefore have no effect -- setting
# TIBLENDER_EMBEDDING_FALLBACK=false does not raise either, because the pin
# happens before the backend is dispatched. `tiblender doctor` reports the pin,
# and every cycle_summary.json records both the requested and the resolved
# backend under `embedding_resolution`.
#
# To actually use bge_large / minilm you need all three of:
#   1. TIBLENDER_MODE=auto or live (note: this also enables the live tools),
#   2. the optional `sentence-transformers` dependency
#      (`bash install.sh --with-reference`),
#   3. the model weights already in the local cache -- the loaders pass
#      local_files_only=TIBLENDER_EMBEDDING_LOCAL_FILES_ONLY (default true),
#      so nothing is downloaded at run time.
TIBLENDER_JACCARD_THRESHOLD=0.25
TIBLENDER_ABSORPTION_THRESHOLD=0.75
TIBLENDER_MIN_CLUSTER_SIZE=3
TIBLENDER_MIN_SAMPLES=2
TIBLENDER_CLUSTER_EPSILON=0.08
TIBLENDER_EMBEDDING_BACKEND=hashing
TIBLENDER_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
TIBLENDER_EMBEDDING_FEATURES=384
TIBLENDER_EMBEDDING_FALLBACK=true
TIBLENDER_EMBEDDING_LOCAL_FILES_ONLY=true
TIBLENDER_EMBEDDING_DEVICE=
TIBLENDER_HDBSCAN_BACKEND=sklearn
TIBLENDER_MERGE_SIMILARITY_THRESHOLD=0.92
TIBLENDER_MERGE_MAX_TIME_GAP_SECONDS=21600
TIBLENDER_MERGE_MIN_CONTEXT_OVERLAP=2
TIBLENDER_MIN_SEVERITY=MEDIUM

# Step 3: multi-perspective / RL-guided investigation
# Default parameters: similarity gate=0.6, max steps=10, action top-K=5.
# TIBLENDER_RL_POLICY_BACKEND accepts multiaction_dqn (default, the numpy
# MultiAction DQN policy) or disabled (always run the multi-perspective sweep).
TIBLENDER_RL_SIMILARITY_GATE=0.60
TIBLENDER_RL_MAX_STEPS=10
TIBLENDER_RL_ACTION_TOP_K=5
TIBLENDER_RL_POLICY_BACKEND=multiaction_dqn
TIBLENDER_REFERENCE_RL_HIDDEN_DIM=256
TIBLENDER_REFERENCE_RL_DROPOUT=0.10
TIBLENDER_REFERENCE_RL_BC_EPOCHS=20
TIBLENDER_REFERENCE_RL_BC_BATCH_SIZE=32
TIBLENDER_REFERENCE_RL_BC_LEARNING_RATE=0.0003
TIBLENDER_REFERENCE_RL_BC_PATIENCE=3
TIBLENDER_REFERENCE_RL_BC_VALIDATION_SPLIT=0.10
TIBLENDER_REFERENCE_RL_DQN_EPISODES=50
TIBLENDER_REFERENCE_RL_DQN_LEARNING_RATE=0.0001
TIBLENDER_REFERENCE_RL_REPLAY_CAPACITY=10000
TIBLENDER_REFERENCE_RL_TRAINING_MIN_TRANSITIONS=1000
TIBLENDER_REFERENCE_RL_EPSILON_INIT=1.0
TIBLENDER_REFERENCE_RL_EPSILON_MIN=0.01
TIBLENDER_REFERENCE_RL_EPSILON_DECAY=0.9
TIBLENDER_REFERENCE_RL_DISCOUNT=0.99
TIBLENDER_MAX_QUERIES_PER_PERSPECTIVE=5
TIBLENDER_ENABLE_PIVOT_IOCS=true

# Step 4: adaptive evaluation loop
# By default, both judges inherit the main LLM profile above. Configure these
# optional overrides only when reproducing independent-judge deployments.
TIBLENDER_MAX_EVAL_ROUNDS=3
TIBLENDER_JUDGE_A_PROVIDER=
TIBLENDER_JUDGE_A_MODEL=
TIBLENDER_JUDGE_A_OPENAI_BASE_URL=
TIBLENDER_JUDGE_A_OPENAI_API_KEY=
TIBLENDER_JUDGE_A_AZURE_OPENAI_ENDPOINT=
TIBLENDER_JUDGE_A_AZURE_OPENAI_DEPLOYMENT=
TIBLENDER_JUDGE_A_AZURE_OPENAI_API_KEY=
TIBLENDER_JUDGE_A_AZURE_OPENAI_API_VERSION=
TIBLENDER_JUDGE_B_PROVIDER=
TIBLENDER_JUDGE_B_MODEL=
TIBLENDER_JUDGE_B_OPENAI_BASE_URL=
TIBLENDER_JUDGE_B_OPENAI_API_KEY=
TIBLENDER_JUDGE_B_AZURE_OPENAI_ENDPOINT=
TIBLENDER_JUDGE_B_AZURE_OPENAI_DEPLOYMENT=
TIBLENDER_JUDGE_B_AZURE_OPENAI_API_KEY=
TIBLENDER_JUDGE_B_AZURE_OPENAI_API_VERSION=

# Cross-cycle feedback: trend query adaptation
# Default parameters: W=168h, tau_sim=0.80, k=1.5, theta_ew=0.75.
TIBLENDER_TREND_WINDOW_HOURS=168
TIBLENDER_TREND_SIM_THRESHOLD=0.80
TIBLENDER_VOLUME_SIGMA_K=1.5
# VOLUME compares this cycle's cluster post count against mu + k*sigma of the
# post counts of the similar historical snapshots (cosine >= tau_sim, inside
# W). Two gates guard that statistic, both at the deployed system's defaults:
# at least this many similar historical snapshots must exist before a
# mu/sigma test is attempted, ...
TIBLENDER_TREND_MIN_SIMILAR_SNAPSHOTS=4
# ... and the current cluster must itself hold at least this many posts.
TIBLENDER_TREND_VOLUME_MIN_POSTS=4
TIBLENDER_EARLY_WARNING_THRESHOLD=0.75
# hashing (default, deterministic) or minilm (sentence-transformers all-MiniLM-L6-v2,
# local files only, falls back to hashing when the model cache is unavailable).
TIBLENDER_TREND_EMBEDDING_BACKEND=hashing
